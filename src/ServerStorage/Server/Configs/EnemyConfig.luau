--!strict
--[[
	GENERATED from the Config folder inside every model of ServerStorage.Enemies,
	Bosses and Halloween in the legacy place. Keyed by model name.
	Max health is derived from Levels (StatConfig.GetHealthFromLevels).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StatConfig = require(ReplicatedStorage.Shared.Configs.StatConfig)

export type EnemyDefinition = {
	Levels: StatConfig.Levels,
	-- Flat damage per attack and the trait it is dealt as.
	Damage: number,
	DamageTrait: "Melee" | "Sword" | "Special" | "Haki",
	FollowDistance: number,
	RespawnTime: number,
	WalkSpeed: number,
	Ranged: boolean?,
	-- Ranged enemies only: how far they shoot and the delay between shots
	-- (Config.Ranged.Range / Cooldown in the legacy models).
	RangedRange: number?,
	RangedCooldown: number?,
	-- Distance from its spawn point at which it gives up a chase and walks back.
	-- Defaults to three times FollowDistance (at least 80 studs).
	LeashDistance: number?,
	-- Never a world spawn: only spawned by EnemyService:SpawnEvent (raid enemies).
	OnDemand: boolean?,
	Boss: boolean?,
	-- Devil fruit whose passive (logia immunity) the enemy uses.
	Fruit: string?,
}


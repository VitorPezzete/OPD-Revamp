for _, name in { "ChillyBoss", "MagmaBoss", "QuakeBoss", "CandyBoss", "SandBoss", "RandomBoss" } do
	if not Enemies[name] then
		Enemies[name] = {
			Levels = { Melee = 800, Defense = 40000, Sniper = 800, Sword = 0, Haki = 0, Special = 800 },
